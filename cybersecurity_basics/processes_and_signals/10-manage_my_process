#!/usr/bin/env bash
# Init script to manage manage_my_process
PIDFILE="/tmp/my_process.pid"

start() {
    if [ -f "$PIDFILE" ]; then
        echo "manage_my_process already running (PID $(cat $PIDFILE))"
        exit 1
    fi
    ./manage_my_process &
    echo $! > "$PIDFILE"
    echo "manage_my_process started"
}

stop() {
    if [ ! -f "$PIDFILE" ]; then
        echo "manage_my_process not running"
        exit 1
    fi
    kill "$(cat $PIDFILE)"
    rm -f "$PIDFILE"
    echo "manage_my_process stopped"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop > /dev/null 2>&1
        start > /dev/null 2>&1
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
